# Generate random local demo values with npm run setup:demo.
# Hub values. Never store provider private keys on a production hotel hub.
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
HOTEL_ID=replace-with-uuid-v4
INSTALLATION_ID=replace-with-stable-installation-uuid-v4
DATABASE_URL=postgresql://hotel_app:CHANGE_ME@localhost:5432/hotel?schema=public
LICENSE_DATABASE_URL=postgresql://license_agent:CHANGE_ME@localhost:5432/hotel?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-characters
LICENSE_PUBLIC_KEY_FILE=secrets/license-public.pem
HUB_LICENSE_KEY=key-issued-by-provider
PROVIDER_URL=http://localhost:4001
BACKUP_DIR=backups
PRINTER_INTERFACE=tcp://192.168.1.200:9100
# Migration/provision/backup process only, not the running app.
# Phase 4 sync. The hub holds no cloud database credentials: it calls the cloud sync API
# with HUB_LICENSE_KEY. Leave SYNC_DATABASE_URL or CLOUD_SYNC_URL empty to run offline only.
SYNC_DB_PASSWORD=replace-with-24-random-characters
SYNC_DATABASE_URL=postgresql://sync_agent:CHANGE_ME@localhost:5432/hotel?schema=public
CLOUD_SYNC_URL=https://sync.your-provider.example
CLOUD_DASHBOARD_URL=https://sync.your-provider.example/dashboard
# Phase 6: public address of the cloud (booking site) and the cloud's sealing public key.
CLOUD_PUBLIC_URL=https://sync.your-provider.example
CLOUD_SEALING_PUBLIC_KEY_FILE=secrets/cloud-sealing-public.pem
MIGRATION_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/hotel?schema=public
CLOUD_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5433/cloud?schema=public
POSTGRES_PASSWORD=replace-with-24-random-characters
HOTEL_DB_PASSWORD=replace-with-24-random-characters
PROVIDER_DB_PASSWORD=replace-with-24-random-characters
LICENSE_DB_PASSWORD=replace-with-24-random-characters
SEED_ADMIN_EMAIL=admin@demo.hotel
SEED_ADMIN_PASSWORD=replace-with-12-to-72-character-password
SEED_HOTEL_NAME=Demo Hotel
# Cloud sync API only (runs beside Supabase, never on a hub).
CLOUD_SYNC_DATABASE_URL=postgresql://sync_agent:CHANGE_ME@db.your-project.supabase.co:5432/postgres?sslmode=require
CLOUD_PORT=4002
# Phase 5 remote management dashboard and cloud departure export. Read-only role.
# Leave CLOUD_REPORT_DATABASE_URL empty and the cloud serves sync only.
REPORT_DB_PASSWORD=replace-with-24-random-characters
CLOUD_REPORT_DATABASE_URL=postgresql://report_reader:CHANGE_ME@db.your-project.supabase.co:5432/postgres?sslmode=require
# Phase 6 public booking site and guest messages (cloud only).
BOOKING_DB_PASSWORD=replace-with-24-random-characters
CLOUD_BOOKING_DATABASE_URL=postgresql://booking_agent:CHANGE_ME@db.your-project.supabase.co:5432/postgres?sslmode=require
CLOUD_SEALING_PRIVATE_KEY_FILE=secrets/cloud-sealing-private.pem
# HTTPS endpoint that sends each guest message (email/SMS provider or relay), HMAC signed.
NOTIFY_WEBHOOK_URL=https://messages.your-provider.example/hotel-hub
NOTIFY_WEBHOOK_SECRET=replace-with-32-random-characters
# Provider service only. Separate host and secrets in production.
PROVIDER_PORT=4001
PROVIDER_ORIGIN=http://localhost:5174
PROVIDER_DATABASE_URL=postgresql://provider_app:CHANGE_ME@localhost:5433/cloud?schema=public
PROVIDER_JWT_SECRET=replace-with-a-different-32-character-secret
PROVIDER_PASSWORD_HASH=replace-with-bcrypt-hash
LICENSE_PRIVATE_KEY_FILE=secrets/license-private.pem
# No global Paystack or Flutterwave credentials. Use tenant credential API.
