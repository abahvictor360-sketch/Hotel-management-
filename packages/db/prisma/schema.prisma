generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}

enum RoomStatus {
 available
 occupied
 reserved
 dirty
 maintenance
}

enum ReservationStatus {
 pending
 confirmed
 checked_in
 checked_out
 cancelled
 no_show
}

enum BookingSource {
 walk_in
 phone
 online
}

enum FolioStatus {
 open
 closed
}

enum OrderStatus {
 pending
 served
 cancelled
}

enum PaymentMethod {
 cash
 pos
 transfer
 online
}

enum Gateway {
 paystack
 flutterwave
}

enum SyncOperation {
 insert
 update
}

enum SyncStatus {
 pending
 sent
 failed
}

enum TaskStatus {
 pending
 in_progress
 completed
 cancelled
}

enum OnlineStatus {
 pending
 confirmed
 rejected
}

enum SubscriptionStatus {
 trial
 active
 past_due
 suspended
 cancelled
}

enum PlanTier {
 standard
 premium
}

model tenants {
 id String @db.Uuid @id
 tenant_id String @db.Uuid
 created_at DateTime @db.Timestamptz(6) @default(now())
 updated_at DateTime @db.Timestamptz(6) @default(now())
 deleted_at DateTime? @db.Timestamptz(6)
 device_id String @db.Text @default("hub")
 created_by String? @db.Uuid
 name String @db.Text
 slug String @db.Text
 branding Json @db.JsonB
 timezone String @db.Text @default("Africa/Lagos")
 currency String @db.Text @default("NGN")
 currency_symbol String @db.Text @default("₦")
 schema_version Int  @default(1)
 @@unique([tenant_id, slug])
 @@unique([tenant_id, id])
 @@index([tenant_id])
 @@index([tenant_id, created_by])
}

model roles {
 id String @db.Uuid @id
 tenant_id String @db.Uuid
 created_at DateTime @db.Timestamptz(6) @default(now())
 updated_at DateTime @db.Timestamptz(6) @default(now())
 deleted_at DateTime? @db.Timestamptz(6)
 device_id String @db.Text @default("hub")
 created_by String? @db.Uuid
 name String @db.Text
 permissions Json @db.JsonB
 @@unique([tenant_id, name])
 @@unique([tenant_id, id])
 @@index([tenant_id])
 @@index([tenant_id, created_by])
 back_users_role_id users[] @relation("users_role_id")
}

model users {
 id String @db.Uuid @id
 tenant_id String @db.Uuid
 created_at DateTime @db.Timestamptz(6) @default(now())
