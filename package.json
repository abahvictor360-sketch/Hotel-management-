{
  "name": "hotel-hub",
  "version": "0.5.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "migrate": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "seed": "node --import tsx scripts/seed.ts",
    "dev": "node --import tsx --watch apps/api/src/server.ts",
    "dev:provider": "node --import tsx --watch apps/api/src/provider-server.ts",
    "dev:web": "npm run dev -w @hotel/web",
    "dev:console": "npm run dev -w @hotel/provider",
    "build": "tsc --noEmit && npm run build -w @hotel/web && npm run build -w @hotel/provider",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:postgres": "node --import tsx --test --test-concurrency=1 tests/postgres.integration.ts",
    "start": "node --import tsx apps/api/src/server.ts",
    "start:provider": "node --import tsx apps/api/src/provider-server.ts",
    "start:cloud": "node --import tsx apps/api/src/cloud-server.ts",
    "dev:cloud": "node --import tsx --watch apps/api/src/cloud-server.ts",
    "setup:demo": "node --import tsx scripts/configure-demo.ts",
    "backup": "node --import tsx scripts/backup.ts",
    "provision:hub": "node --import tsx scripts/provision-hub.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.2",
    "cookie-parser": "1.4.7",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "express-rate-limit": "7.5.1",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "node-thermal-printer": "4.5.0",
    "pg": "8.16.3",
    "pm2": "7.0.4",
    "serialport": "13.0.0",
    "tsx": "4.20.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "4.17.23",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "prettier": "3.6.2",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "typescript": "5.9.2"
  },
  "type": "module",
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "js-yaml": "4.3.2"
  }
}
